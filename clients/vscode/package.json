{
  "name": "contextos",
  "displayName": "ContextOS",
  "description": "ContextOS L5 indexing + L3 symbol DX + L1 blast graph — triggers FastAPI; policy stays server-side.",
  "version": "0.1.0",
  "publisher": "contextos",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextos.indexRepository",
        "title": "ContextOS: Index Repository"
      },
      {
        "command": "contextos.definitionLookup",
        "title": "ContextOS: Go to Definition (Serena)"
      },
      {
        "command": "contextos.findReferences",
        "title": "ContextOS: Find All References"
      },
      {
        "command": "contextos.renameScopeAnalysis",
        "title": "ContextOS: Rename Scope Analysis"
      },
      {
        "command": "contextos.packContext",
        "title": "ContextOS: Pack Context"
      },
      {
        "command": "contextos.askContext",
        "title": "ContextOS: Ask ContextOS"
      },
      {
        "command": "contextos.showBlastGraph",
        "title": "ContextOS: Show Blast Graph"
      }
    ],
    "keybindings": [
      {
        "command": "contextos.askContext",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "contextos.askContext",
          "group": "contextos@0",
          "when": "editorTextFocus"
        },
        {
          "command": "contextos.packContext",
          "group": "contextos@1",
          "when": "editorTextFocus"
        },
        {
          "command": "contextos.showBlastGraph",
          "group": "contextos@1a",
          "when": "editorTextFocus"
        },
        {
          "command": "contextos.definitionLookup",
          "group": "contextos@2",
          "when": "editorTextFocus"
        },
        {
          "command": "contextos.findReferences",
          "group": "contextos@3",
          "when": "editorTextFocus"
        },
        {
          "command": "contextos.renameScopeAnalysis",
          "group": "contextos@4",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "ContextOS",
      "properties": {
        "contextos.orchestratorBaseUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Proposed: FastAPI orchestrator base URL (no trailing slash). Not a Confirmed product setting key."
        },
        "contextos.autoIndexOnActivate": {
          "type": "boolean",
          "default": true,
          "description": "Proposed: trigger POST /index on extension activation when a workspace folder is open."
        },
        "contextos.reindexOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Proposed: on file save, call POST /index with Proposed optional files scope (OQ-14 — not Confirmed)."
        },
        "contextos.indexTimeoutMs": {
          "type": "number",
          "default": 600000,
          "minimum": 1000,
          "description": "Proposed: client-side AbortSignal timeout for POST /index (ms)."
        },
        "contextos.enableGraphBlastPanel": {
          "type": "boolean",
          "default": true,
          "description": "Proposed: enable ContextOS React Flow blast/graph Webview panel (EP-007 US-020)."
        },
        "contextos.showStalenessWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Proposed: show staleness badge/warnings when freshness metadata indicates drift (EP-007 US-027). Numeric threshold remains NEEDS CLARIFICATION."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "node scripts/build-webview.mjs",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p ./ --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
